# A plain C project with everything in one folder: targets with path "." live in the root CMakeLists.txt

project("Stack", version="0.1.0", lang="c11")

@StaticLibrary(".")
target stack():
    def configure(self):
        self.sources = ["stack.c"]
        self.exports.includes = ["."]
        if platform != "windows":
            self.link += ["m"]

@Executable(".", test=True)
target stack_test(PRIVATE stack):
    def configure(self):
        self.sources = ["test.c"]
