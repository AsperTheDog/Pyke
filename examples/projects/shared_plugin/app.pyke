# A static core, a shared plugin that uses it, and an executable that loads the plugin

project("Lib", version="3.1.4", lang="c++17")

option sanitize: bool = False

@StaticLibrary("core")
target core():
    def configure(self):
        self.sources = ["core.cpp"]

@SharedLibrary("plugin")
target plugin(PRIVATE core):
    def configure(self):
        self.sources = ["plugin.cpp"]
        if sanitize:
            self.flags += ["-fsanitize=address"]
    def install(self):
        self.library = "lib"

@Executable("app", test=True)
target app(PRIVATE plugin):
    def configure(self):
        self.sources = ["main.cpp"]
